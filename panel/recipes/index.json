{
  "index": 1,
  "description": "Every recipe a schema may name. kind is the adapter it fills. settings is a JSON Schema for the adapter's keys other than recipe, notes, behavior, and x- keys. status: planned (listed, not written), unverified (written, verification not run), verified. file is the recipe, next to this index.",
  "recipes": {
    "none": {
      "kind": "auth",
      "status": "verified",
      "summary": "No sign-in: one button opens the panel. Also used when the schema names no auth. Only for panels that run locally and are never exposed to a network.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "verification": "evals/recipes/",
      "file": "none.md"
    },
    "password": {
      "kind": "auth",
      "status": "verified",
      "summary": "One shared password, kept in an environment variable on the server.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "password_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Name of the environment variable holding the password. Default PANEL_PASSWORD. Never the password itself."
          }
        }
      },
      "verification": "evals/recipes/",
      "file": "password.md"
    },
    "google-login": {
      "kind": "auth",
      "status": "verified",
      "summary": "Sign in with Google. Only listed addresses get in.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow"
        ],
        "properties": {
          "allow": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+|\\*@[^@\\s]+\\.[^@\\s]+)$"
            },
            "description": "Email addresses, or *@domain for a whole domain."
          }
        }
      },
      "verification": "evals/recipes/",
      "file": "google-login.md"
    },
    "email-link": {
      "kind": "auth",
      "status": "unverified",
      "summary": "Sign in with a one-time link sent by email. Only listed addresses get in.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow"
        ],
        "properties": {
          "allow": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+|\\*@[^@\\s]+\\.[^@\\s]+)$"
            }
          }
        }
      },
      "file": "email-link.md"
    },
    "json-files": {
      "kind": "data",
      "status": "verified",
      "summary": "One JSON file per item in a folder. Written by a small server, or without one (see via).",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "via": {
            "enum": [
              "server",
              "file-system-access",
              "github",
              "download",
              "local-storage"
            ],
            "description": "How files get written. Default server."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "description": "owner/name. Required when via is github."
          },
          "branch": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "via": {
              "const": "github"
            }
          },
          "required": [
            "via"
          ]
        },
        "then": {
          "required": [
            "repo"
          ]
        },
        "else": {
          "properties": {
            "repo": false,
            "branch": false
          }
        }
      },
      "verification": "evals/recipes/",
      "file": "json-files.md"
    },
    "postgres": {
      "kind": "data",
      "status": "unverified",
      "summary": "A Postgres database reached by a connection string in an environment variable.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url_env"
        ],
        "properties": {
          "url_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Name of the environment variable holding the connection string. Never the string itself."
          },
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "file": "postgres.md"
    },
    "supabase": {
      "kind": "data",
      "status": "unverified",
      "summary": "A Supabase project's database.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url_env",
          "key_env"
        ],
        "properties": {
          "url_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "key_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "file": "supabase.md"
    },
    "local-disk": {
      "kind": "files",
      "status": "verified",
      "summary": "Uploads saved to a folder and served from a URL path.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Public URL path the folder is served from. Default /uploads."
          },
          "via": {
            "enum": [
              "server",
              "file-system-access"
            ]
          }
        }
      },
      "verification": "evals/recipes/",
      "file": "local-disk.md"
    },
    "s3": {
      "kind": "files",
      "status": "unverified",
      "summary": "Uploads stored in an S3 bucket.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucket",
          "region"
        ],
        "properties": {
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "file": "s3.md"
    },
    "r2": {
      "kind": "files",
      "status": "unverified",
      "summary": "Uploads stored in a Cloudflare R2 bucket.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucket",
          "account_env"
        ],
        "properties": {
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "account_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "file": "r2.md"
    }
  }
}
