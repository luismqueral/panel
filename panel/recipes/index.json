{
  "index": 1,
  "description": "Every recipe a schema may name. kind is the adapter it fills. settings is a JSON Schema for the adapter's keys other than recipe, notes, behavior, and x- keys. status: planned (listed, not written), unverified (written, verification not run), verified.",
  "recipes": {
    "none": {
      "kind": "auth",
      "status": "planned",
      "summary": "No login. Only for panels that run locally and are never exposed to a network.",
      "settings": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    "google-login": {
      "kind": "auth",
      "status": "planned",
      "summary": "Sign in with Google. Only listed addresses get in.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allow"],
        "properties": {
          "allow": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+|\\*@[^@\\s]+\\.[^@\\s]+)$" },
            "description": "Email addresses, or *@domain for a whole domain."
          }
        }
      }
    },
    "email-link": {
      "kind": "auth",
      "status": "planned",
      "summary": "Sign in with a one-time link sent by email. Only listed addresses get in.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allow"],
        "properties": {
          "allow": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+|\\*@[^@\\s]+\\.[^@\\s]+)$" }
          }
        }
      }
    },
    "json-files": {
      "kind": "data",
      "status": "planned",
      "summary": "One JSON file per item in a folder. Written by a small server, or without one (see via).",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "via": { "enum": ["server", "file-system-access", "github", "download", "local-storage"], "description": "How files get written. Default server." },
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "owner/name. Required when via is github." },
          "branch": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "via": { "const": "github" } }, "required": ["via"] },
        "then": { "required": ["repo"] },
        "else": { "properties": { "repo": false, "branch": false } }
      }
    },
    "postgres": {
      "kind": "data",
      "status": "planned",
      "summary": "A Postgres database reached by a connection string in an environment variable.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url_env"],
        "properties": {
          "url_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Name of the environment variable holding the connection string. Never the string itself." },
          "schema": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supabase": {
      "kind": "data",
      "status": "planned",
      "summary": "A Supabase project's database.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url_env", "key_env"],
        "properties": {
          "url_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "local-disk": {
      "kind": "files",
      "status": "planned",
      "summary": "Uploads saved to a folder and served from a URL path.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1, "description": "Public URL path the folder is served from. Default /uploads." },
          "via": { "enum": ["server", "file-system-access"] }
        }
      }
    },
    "s3": {
      "kind": "files",
      "status": "planned",
      "summary": "Uploads stored in an S3 bucket.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "region"],
        "properties": {
          "bucket": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "r2": {
      "kind": "files",
      "status": "planned",
      "summary": "Uploads stored in a Cloudflare R2 bucket.",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "account_env"],
        "properties": {
          "bucket": { "type": "string", "minLength": 1 },
          "account_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
