{
  "panel": 1,
  "name": "Field Notes",
  "auth": {
    "recipe": "google-login",
    "allow": [
      "me@example.com"
    ]
  },
  "data": {
    "recipe": "json-files",
    "path": "./content",
    "via": "github",
    "repo": "me/site"
  },
  "types": [
    {
      "id": "post",
      "label": "Posts",
      "status": [
        "draft",
        "published"
      ],
      "list": {
        "title": "title",
        "sort": "-date"
      },
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "date",
          "type": "date",
          "default": "2026-01-01"
        }
      ]
    }
  ]
}
